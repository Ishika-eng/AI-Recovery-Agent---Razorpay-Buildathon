# Copy this file to .env and fill in what you need. Only DATABASE_URL and
# SESSION_SECRET are required to run the app at all — everything else is
# optional and the platform falls back to a clearly-labeled simulated mode
# when it's missing (see README "Real customer contact").

# SQLite — a plain local file, created automatically by `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# Session cookie signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- Optional: real Razorpay test-mode delivery -----------------------
# Without these, GENERATE_PAYMENT_LINK / OFFER_ALTERNATIVE_PAYMENT_METHOD
# fall back to a simulated outcome instead of creating a real payment link.
# https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional: real Stripe webhook verification ------------------------
STRIPE_WEBHOOK_SECRET=

# --- Optional: real email delivery for reminders/links ------------------
# Without these, customer-facing emails fall back to a simulated outcome
# instead of actually sending.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional: protects POST /api/cron/tick in a real deployment --------
# Required by Vercel Cron in production if you want the endpoint gated;
# leave unset for local development with `npm run scheduler`.
CRON_SECRET=

# --- Optional: real LLM-generated customer messages ---------------------
# Free-tier key from https://console.groq.com/keys. Without this, the voice
# script and email copy fall back to their deterministic templates — nothing
# breaks, it's just less personalized.
GROQ_API_KEY=
GROQ_MODEL=
